{
  "name": "VP Season Archive",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "5 0 * * *"
            }
          ]
        }
      },
      "id": "daily",
      "name": "Daily archive check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$vars.SUPABASE_URL}}/rest/v1/seasons?status=eq.active&select=*",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$vars.SUPABASE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$vars.SUPABASE_KEY}}"
            }
          ]
        }
      },
      "id": "get-seasons",
      "name": "Get active seasons",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$vars.PYTHON_API_URL}}/v1/season-consistency",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ snapshots: $json.snapshots || [] }) }}"
      },
      "id": "classify",
      "name": "Python classify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ]
    }
  ],
  "connections": {
    "Daily archive check": {
      "main": [
        [
          {
            "node": "Get active seasons",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get active seasons": {
      "main": [
        [
          {
            "node": "Python classify",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
