{
  "name": "VP Daily Task Generation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      },
      "id": "schedule-midnight",
      "name": "Every midnight",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$vars.SUPABASE_URL}}/rest/v1/seasons?status=eq.active&select=*",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$vars.SUPABASE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$vars.SUPABASE_KEY}}"
            }
          ]
        }
      },
      "id": "get-seasons",
      "name": "Get active seasons",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.open-meteo.com/v1/forecast?latitude=16.84&longitude=96.17&current=temperature_2m,cloud_cover,weather_code,is_day,precipitation"
      },
      "id": "get-weather",
      "name": "Get weather",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$vars.PYTHON_API_URL}}/v1/predict-tasks",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ resources: { water: $json.water, sun: $json.sun, fertilizer: $json.fertilizer }, weather: { tempC: $('Get weather').item.json.current.temperature_2m, cloudCover: $('Get weather').item.json.current.cloud_cover, code: $('Get weather').item.json.current.weather_code }, anchors: [] }) }}"
      },
      "id": "python-deck",
      "name": "Python ML task deck",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{$vars.SUPABASE_URL}}/rest/v1/seasons?id=eq.{{$json.seasonId}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ deck: $json.deck, deck_date: $now.toFormat('yyyy-MM-dd') }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$vars.SUPABASE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$vars.SUPABASE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        }
      },
      "id": "store-deck",
      "name": "Store tasks in Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ]
    }
  ],
  "connections": {
    "Every midnight": {
      "main": [
        [
          {
            "node": "Get active seasons",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get active seasons": {
      "main": [
        [
          {
            "node": "Get weather",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get weather": {
      "main": [
        [
          {
            "node": "Python ML task deck",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Python ML task deck": {
      "main": [
        [
          {
            "node": "Store tasks in Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
